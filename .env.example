# Copy this file to ".env" and fill it in:  cp .env.example .env
# Generate secrets with:  openssl rand -hex 24

# --- Required ------------------------------------------------------------
# Used by the Psysonic apps (Settings -> Integrations -> Realtime hub). 16+ characters.
HUB_TOKEN=

# --- Web page login (recommended) ---------------------------------------
# If set, the web page asks for this username and password instead of the token.
# The password needs 10+ characters. Leave both empty to use HUB_TOKEN on the page instead.
HUB_USER=
HUB_PASSWORD=

# --- REST API for automations (optional) --------------------------------
# Full control (play, pause, skip, volume, transfer...). 24+ characters. Leave empty to disable.
API_TOKEN=
# Read-only (state, devices, cover art, live events). 24+ characters, must differ from API_TOKEN.
API_TOKEN_READONLY=
# Public address of the hub, so cover_url in /api/state is an absolute link (e.g. https://hub.example.com)
HUB_PUBLIC_URL=

# --- Handoff safety (optional) ---------------------------------------
# Playback is only handed between devices using the same music server + account. Set to "off" to allow anything.
HUB_SERVER_CHECK=on

# --- Secrets from files (optional, Docker secrets) ----------------------
# Instead of the value you can point to a file: HUB_TOKEN_FILE=/run/secrets/hub_token
# (works for HUB_TOKEN, HUB_PASSWORD, API_TOKEN, API_TOKEN_READONLY)

# --- Limits (optional) ----------------------------------------------------
# HUB_MAX_CONNECTIONS=64
# HUB_MAX_CONNECTIONS_PER_IP=16

# --- Behind a reverse proxy (optional) ----------------------------------
# Set to 1 when a reverse proxy (Caddy, nginx, Traefik) is in front, so the real client address
# and https are taken from X-Forwarded-* headers. Leave 0 when clients connect directly.
HUB_TRUST_PROXY=0
# Extra browser origins allowed to open the web socket / call the API from another site (comma separated)
HUB_ALLOWED_ORIGINS=
HUB_CORS_ORIGINS=
