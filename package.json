{
  "name": "psysonic-hub",
  "version": "0.2.0",
  "description": "Self-hosted realtime hub for Psysonic: device switching, remote control, settings sync and a REST API",
  "private": true,
  "type": "module",
  "main": "server/index.ts",
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.test.json && tsc -p web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && npm run test:server && npm run test:web",
    "test:server": "node test/hub.test.ts && node test/library.test.ts && node test/tokens.test.ts && node test/auth-api.test.ts && node test/hardening.test.ts && node test/security.test.ts",
    "test:web": "vitest run --config web/vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "i18next": "^26.7.2",
    "jsdom": "^31.0.1",
    "lucide-react": "^1.77.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "uqr": "^0.1.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
